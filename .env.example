APP_NAME="AHASS Booking Servis"
APP_ENV=local
APP_KEY=base64:REPLACE_WITH_YOUR_KEY
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL) ---
# Sesuaikan dengan kredensial MySQL Anda.
# Alternatif cepat tanpa server DB: set DB_CONNECTION=sqlite dan
# DB_DATABASE=database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahass_booking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
